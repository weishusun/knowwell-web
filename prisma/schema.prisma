generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  password       String
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  notes          Note[]
  kNotes         KNote[]
  reviews        Review[]
  emailVerified  DateTime?
}

model KNote {
  id            String   @id @default(cuid())
  title         String
  summary       String?
  content       String
  category      String
  tags          String[] // Postgres text array
  coverImageUrl String?
  views         Int      @default(0)
  likes         Int      @default(0)
  isPublished   Boolean  @default(true)

  authorId String
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([authorId])
  @@index([createdAt])
}

model Note {
  id          String    @id @default(cuid())
  title       String
  content     String
  coverUrl    String?
  tags        String[]  @default([])
  author      User      @relation(fields: [authorId], references: [id])
  authorId    String
  reviews     Review[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  body      String
  rating    Int      @default(5)
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  note      Note     @relation(fields: [noteId], references: [id])
  noteId    String
  createdAt DateTime @default(now())
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}
